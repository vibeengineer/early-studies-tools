{
  "$schema": "https://biomejs.dev/schemas/2.1.1/schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": ["**", "!worker-configuration.d.ts"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "suspicious": {
        "noConsole": "off"
      },
      "nursery": {
        "noAwaitInLoop": "off"
      }
    }
  }
}
